<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:background="@color/primary_container">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
  <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_logo" android:contentDescription="@string/app_name"/>
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="ShareX" android:fontFamily="@font/google_sans" android:textStyle="bold" android:textSize="28sp" android:textColor="@color/txt_color"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="DEVICE TO DEVICE" android:letterSpacing="0.12" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/accent_blue"/>
 <TextView android:id="@+id/drawer_server_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Sharing is off" android:textColor="@color/txt_color" android:textSize="15sp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/ver" android:textSize="11sp" android:textColor="@color/txt_color_secondary"/>
</LinearLayout>
