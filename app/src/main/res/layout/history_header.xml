<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TRANSFER ARCHIVE" android:textColor="@color/accent_blue" android:textStyle="bold" android:textSize="11sp" android:letterSpacing="0.12"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="History" android:textStyle="bold" android:textSize="32sp" android:textColor="@color/txt_color"/>
   <ImageButton android:id="@+id/btn_clear_hist" android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp" android:contentDescription="Clear transfer history" android:background="?attr/selectableItemBackgroundBorderless" app:srcCompat="@drawable/ic_delete_swipe" app:tint="@color/txt_color_secondary"/>
  </LinearLayout>
  <TextView android:id="@+id/history_lifetime_totals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:padding="12dp" android:background="@color/primary_container" android:text="Sent 0 B · Received 0 B" android:textColor="@color/txt_color" android:textSize="13sp"/>
  <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/history_direction" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/history_all">
   <com.google.android.material.button.MaterialButton android:id="@+id/history_all" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="All" android:insetTop="0dp" android:insetBottom="0dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/history_sent" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Sent" android:insetTop="0dp" android:insetBottom="0dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/history_received" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Received" android:insetTop="0dp" android:insetBottom="0dp"/>
  </com.google.android.material.button.MaterialButtonToggleGroup>
 </LinearLayout>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="false">
  <com.google.android.material.chip.ChipGroup android:id="@+id/history_types" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="20dp" app:singleLine="true" app:singleSelection="true" app:selectionRequired="true" app:checkedChip="@id/type_all">
   <com.google.android.material.chip.Chip android:id="@+id/type_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="All files" android:checkable="true"/>
<com.google.android.material.chip.Chip android:id="@+id/type_image" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Images" android:checkable="true"/>
<com.google.android.material.chip.Chip android:id="@+id/type_video" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Video" android:checkable="true"/>
<com.google.android.material.chip.Chip android:id="@+id/type_audio" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio" android:checkable="true"/>
<com.google.android.material.chip.Chip android:id="@+id/type_document" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Documents" android:checkable="true"/>
<com.google.android.material.chip.Chip android:id="@+id/type_other" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Other" android:checkable="true"/>
  </com.google.android.material.chip.ChipGroup>
 </HorizontalScrollView>
 <TextView android:id="@+id/history_record_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:text="No transfers" android:textSize="12sp" android:textColor="@color/txt_color_secondary"/>
</LinearLayout>
