<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="104dp" android:layout_height="104dp" app:cardCornerRadius="28dp" app:cardBackgroundColor="@color/primary_container" app:strokeWidth="0dp" app:cardElevation="0dp">
            <ImageView android:id="@+id/intro_page_icon" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="24dp" android:importantForAccessibility="no" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/intro_page_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:textColor="@color/txt_color" android:textSize="30sp" android:textStyle="bold" android:gravity="center" android:accessibilityHeading="true" />
        <TextView android:id="@+id/intro_page_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/txt_color_secondary" android:textSize="16sp" android:gravity="center" android:lineSpacingExtra="4dp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:cardCornerRadius="20dp" app:cardBackgroundColor="@color/surface_container" app:strokeColor="@color/outline_soft" app:strokeWidth="1dp" app:cardElevation="0dp">
            <TextView android:id="@+id/intro_page_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textColor="@color/txt_color" android:textSize="15sp" android:lineSpacingExtra="5dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
